APP_NAME=CravaCloud
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cravacloud
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=720
REDIS_QUEUE_RETRY_AFTER=720

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@cravacloud.id
MAIL_FROM_NAME="CravaCloud"
MAIL_SUPPORT_ADDRESS=support@cravacloud.id
MAIL_SUPPORT_NAME="CravaCloud Support"
MAIL_REPLY_TO_ADDRESS=support@cravacloud.id
MAIL_ADMIN_ADDRESSES=support@cravacloud.id,admin@gmail.com
MAIL_ALLOWED_SENDER_DOMAINS=cravacloud.id

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin Initial Credentials / Seeder
ADMIN_NAME="Administrator"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="12345678"
ADMIN_PHONE="6285776361743"
ADMIN_COMPANY="CravaCloud Indonesia"
ADMIN_API_KEY="generate_strong_secret_key_here"

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_VERIFY_WEBHOOK_VIA_API=true

# CravaCloud Business Config
CRAVACLOUD_WHATSAPP="6285776361743"
CRAVACLOUD_SUPPORT_EMAIL="support@cravacloud.id"
CRAVACLOUD_ADMIN_EMAIL="support@cravacloud.id"

# Google OAuth Credentials & Search Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"


# Akun tertaut dengan CravaCloud WA Gateway (hanya autentikasi). URL = alamat WA
# Gateway di tahap yang sama; SECRET identik di kedua aplikasi, beda tiap tahap.
# Kosong = penautan mati.
LINKED_ACCOUNTS_URL=
LINKED_ACCOUNTS_SECRET=

# WhatsApp Gateway Integration (VexaHost WA Gateway — dikelola penuh via .env)
WA_GATEWAY_ENABLED=false
WA_GATEWAY_URL=https://wa.vexahostcloud.my.id
WA_GATEWAY_KEY=
WA_GATEWAY_SESSION=
WA_GATEWAY_TIMEOUT=5
WA_GATEWAY_CONNECT_TIMEOUT=3
WA_GATEWAY_HEALTH_CACHE_SECONDS=30
WA_GATEWAY_WEBHOOK_SECRET=

# Provisioning driver: 'manual' (default, admin input) atau adapter real.
# Tencent Cloud = internal infrastructure provider (white-label: pelanggan
# tetap melihat 'cravacloud'). JANGAN commit nilai SecretId/SecretKey.
PROVISIONING_DRIVER=manual
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-jakarta
TENCENT_API_TIMEOUT=30
TENCENT_LOW_BALANCE_USD=20
TENCENT_QUOTA_WARN_PCT=80
# Divisor unit saldo DescribeAccountBalance (100 = sen). Verifikasi ulang via
# tencent:probe --live setelah saldo non-zero sebelum mengandalkan BalanceGuard.
TENCENT_BALANCE_DIVISOR=100
# Polling state instance/operasi/TAT di dalam satu attempt job. Bila melewati
# POLL_MAX, job retry (resume dari checkpoint) — bukan gagal permanen.
TENCENT_POLL_INTERVAL=5
TENCENT_POLL_MAX=240
# Retensi lifecycle (D5): instance di recycle bin (SHUTDOWN) masih bisa
# dipulihkan via RenewInstances selama N hari; terminate permanen menunggu
# masa tenggang pelanggan DAN jendela aman upstream ini (tidak hardcode 7).
TENCENT_RECYCLE_BIN_RETENTION_DAYS=15
TENCENT_TERMINATE_SAFETY_DAYS=12
